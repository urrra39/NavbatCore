// =============================================================================
// NavbatCore — Multi-Tenant Real-Time Clinic Queue Infrastructure
// -----------------------------------------------------------------------------
// Topology
//   * Shared-database / shared-schema multi-tenancy. Every tenant-owned row
//     carries a `clinicId` discriminator and unique constraints are scoped
//     to it. Application-layer guarantees come from Zod (see src/schemas).
//
//   * Three physical tables back the ticket lifecycle:
//       HotTicket          — active rows, narrow indexes, kept slim.
//       ColdTicketArchive  — encrypted (AES-256-GCM) + gzipped snapshots
//                            of terminal tickets older than retentionDays.
//       AuditLog           — append-only, HMAC-chained immutable ledger.
//
//   * All temporal columns use `Timestamptz(6)` — microsecond precision
//     for the dashboard tickers and the smart ETA calculator.
//
//   * Status enum is the Uzbek-coded vocabulary (KUTMOQDA, TASDIQLANGAN,
//     QABULDA, TUGATILDI, BEKOR_QILINGAN, KELMADI). The same identifiers
//     appear in the Zod schemas (src/schemas/ticket.ts) and the UI labels
//     (src/lib/triage.ts) — no translation tables, no drift.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "metrics"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum ClinicPlan {
  FREE
  STANDARD
  PRO
  ENTERPRISE
}

enum UserRole {
  SUPER_ADMIN     // Cross-tenant operator (Bosh administrator)
  CLINIC_ADMIN    // Tenant-isolated administrator (Klinika administratori)
  RECEPTIONIST    // Operational front desk (Qabulchi)
  DOCTOR          // Read-only personal queue (Shifokor)
  PATIENT         // Public booking portal user
}

enum TicketStatus {
  KUTMOQDA          // Waiting in queue
  TASDIQLANGAN      // Confirmed by reception
  QABULDA           // Currently being seen by doctor
  TUGATILDI         // Completed
  BEKOR_QILINGAN    // Canceled
  KELMADI           // No-show
}

enum Severity {
  YENGIL    // Light    — 15 min budget
  ORTA      // Medium   — 25 min budget
  OGIR      // Severe   — 45 min budget (or more, configurable)
}

enum TicketChannel {
  WEB
  MOBILE_APP
  WALK_IN
  PHONE
  PARTNER_API   // HIS gateway insertions
}

enum AuditAction {
  TICKET_CREATED
  TICKET_STATE_TRANSITION
  TICKET_RESCHEDULED
  TICKET_ARCHIVED
  TICKET_PURGED
  EMERGENCY_BUFFER_INSERTED
  QUEUE_RECALCULATED
  CLINIC_SETTINGS_UPDATED
  SLA_BREACH_DETECTED
  USER_INVITED
  USER_REVOKED
}

enum ArchiveCipher {
  AES_256_GCM
}

enum ArchiveCompression {
  GZIP
  BROTLI
  NONE
}

// -----------------------------------------------------------------------------
// Tenant root: Clinic
// -----------------------------------------------------------------------------

model Clinic {
  id              String     @id @default(cuid())
  /// Public, SEO-stable handle used for SSR routes like /c/{slug}.
  slug            String     @unique
  legalName       String
  displayName     String
  plan            ClinicPlan @default(STANDARD)

  // Contact / locale
  city            String?
  countryCode     String     @default("UZ") @db.VarChar(2)
  timezone        String     @default("Asia/Tashkent")
  phone           String?
  email           String?
  addressLine     String?
  geoLat          Float?
  geoLng          Float?

  // SEO surface (consumed by Next.js generateMetadata in /c/[slug]).
  metaTitle       String?
  metaDescription String?    @db.Text
  ogImageUrl      String?
  keywords        String[]   @default([])

  // Admin-tunable runtime settings — validated on write via ClinicSettingsSchema.
  // Shape: {
  //   slotDurationSec, openingHours[], maxQueueDepth, allowOverbook,
  //   graceWindowSec, autoCheckInRadiusMeters, sla: { ... }, ...
  // }
  settings        Json       @default("{}") @db.JsonB

  // Brand theme tokens (logo, primary blue, accent gray).
  theme           Json       @default("{}") @db.JsonB

  /// Retention policy override. Worker uses min(globalDefault, this).
  retentionDays   Int        @default(7)

  isActive        Boolean    @default(true)
  verifiedAt      DateTime?  @db.Timestamptz(6)

  createdAt       DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt      @db.Timestamptz(6)

  users           User[]
  departments     Department[]
  doctors         Doctor[]
  hotTickets     HotTicket[]
  archives        ColdTicketArchive[]
  auditLogs       AuditLog[]
  retentionRuns   RetentionRun[]
  slaIncidents    SlaIncident[]

  @@index([slug])
  @@index([isActive, plan])
  @@index([countryCode, city])
  @@map("clinics")
}

// -----------------------------------------------------------------------------
// User
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  clinicId      String?
  clinic        Clinic?   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  // Patients are not bound to a clinic; staff/admins are.
  role          UserRole  @default(PATIENT)
  email         String?
  phoneE164     String?
  fullName      String
  passwordHash  String?
  locale        String    @default("uz")

  isActive      Boolean   @default(true)
  lastSeenAt    DateTime? @db.Timestamptz(6)

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt      @db.Timestamptz(6)

  hotTickets    HotTicket[] @relation("PatientTickets")
  doctorProfile Doctor?     @relation("DoctorUser")

  @@index([clinicId, email])
  @@index([clinicId, phoneE164])
  @@index([phoneE164])
  @@index([email])
  @@map("users")
}

// -----------------------------------------------------------------------------
// Department & Doctor
// -----------------------------------------------------------------------------

model Department {
  id              String    @id @default(cuid())
  clinicId        String
  clinic          Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  /// Stable code (e.g. "KARDIOLOGIYA") — also used in URLs.
  code            String
  name            String
  description     String?   @db.Text

  /// SLA budget in seconds. Consultations longer than this trigger an alert.
  /// Defaults follow the triage tier (Yengil 15m / O'rta 25m / Og'ir 45m).
  slaThresholdSec Int       @default(1500)

  isActive        Boolean   @default(true)

  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt      @db.Timestamptz(6)

  doctors         Doctor[]
  hotTickets      HotTicket[]

  @@unique([clinicId, code])
  @@index([clinicId, isActive])
  @@map("departments")
}

model Doctor {
  id              String    @id @default(cuid())
  clinicId        String
  clinic          Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])

  /// Optional link to a User row (for login-capable doctors).
  userId          String?   @unique
  user            User?     @relation("DoctorUser", fields: [userId], references: [id])

  fullName        String
  specialty       String?
  bio             String?   @db.Text
  avatarUrl       String?
  isActive        Boolean   @default(true)

  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt      @db.Timestamptz(6)

  hotTickets      HotTicket[]

  @@index([clinicId, departmentId, isActive])
  @@index([clinicId, isActive])
  @@map("doctors")
}

// -----------------------------------------------------------------------------
// HotTicket — the live queue row
// -----------------------------------------------------------------------------
//
// Concurrency contract (zero double-booking):
//   * Every state transition increments `version` and the application
//     issues `UPDATE ... WHERE id=$1 AND version=$expected`.
//   * Position-altering operations (emergency buffer insertion, queue
//     recalculation) MUST run inside a transaction with a per-tenant
//     advisory lock OR use `SELECT ... FOR UPDATE SKIP LOCKED` — see
//     the receptionist-action server actions.
// -----------------------------------------------------------------------------

model HotTicket {
  id               String        @id @default(cuid())

  clinicId         String
  clinic           Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  departmentId     String
  department       Department    @relation(fields: [departmentId], references: [id])

  doctorId         String?
  doctor           Doctor?       @relation(fields: [doctorId], references: [id])

  patientId        String?
  patient          User?         @relation("PatientTickets", fields: [patientId], references: [id])

  /// Public, human-friendly short code (e.g. "K-074"). Unique per clinic.
  /// Patients track their ticket via /t/{ticketCode} — never via id.
  ticketCode       String

  status           TicketStatus  @default(KUTMOQDA)
  severity         Severity
  channel          TicketChannel @default(WEB)
  priority         Int           @default(0)

  /// True if the ticket was inserted via the receptionist's emergency
  /// buffer interceptor — used by the worker to expedite analytics.
  isEmergency      Boolean       @default(false)

  /// Deterministic ordering when scheduledFor ties.
  positionInDay    Int           @default(0)

  // -- Microsecond-precise lifecycle stamps -------------------------------
  scheduledFor     DateTime      @db.Timestamptz(6)
  enqueuedAt       DateTime      @default(now()) @db.Timestamptz(6)
  confirmedAt      DateTime?     @db.Timestamptz(6)
  startedAt        DateTime?     @db.Timestamptz(6)
  completedAt      DateTime?     @db.Timestamptz(6)
  canceledAt       DateTime?     @db.Timestamptz(6)
  cancelReason     String?

  /// Smart ETA, recomputed after every queue mutation.
  etaAt            DateTime?     @db.Timestamptz(6)
  etaConfidence    Float?

  /// Free-form, validated by Zod (TicketMetadataSchema).
  metadata         Json          @default("{}") @db.JsonB

  /// Optimistic concurrency control.
  version          Int           @default(0)

  /// Anonymous tracking hash — used by /t/{trackingHash} when patients
  /// share the link. Distinct from ticketCode so the public URL is hard
  /// to enumerate.
  trackingHash     String        @unique @default(cuid())

  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt      @db.Timestamptz(6)

  slaIncidents     SlaIncident[]

  @@unique([clinicId, ticketCode])
  @@index([clinicId, status, scheduledFor])
  @@index([clinicId, departmentId, status, scheduledFor])
  @@index([clinicId, status, completedAt])
  @@index([clinicId, doctorId, scheduledFor])
  @@index([patientId, status])
  @@index([etaAt])
  @@index([isEmergency, scheduledFor])
  @@map("hot_tickets")
}

// -----------------------------------------------------------------------------
// ColdTicketArchive — encrypted, compressed, write-once
// -----------------------------------------------------------------------------

model ColdTicketArchive {
  id               String             @id @default(cuid())

  clinicId         String
  clinic           Clinic             @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  originalTicketId String             @unique

  // -- Searchable header (clear) ------------------------------------------
  ticketCode       String
  status           TicketStatus
  severity         Severity
  departmentCode   String?
  doctorName       String?
  scheduledFor     DateTime           @db.Timestamptz(6)
  completedAt      DateTime?          @db.Timestamptz(6)
  canceledAt       DateTime?          @db.Timestamptz(6)
  channel          TicketChannel
  durationSec      Int?

  // -- Encrypted compressed payload ---------------------------------------
  payloadCipher    Bytes
  payloadIv        Bytes
  payloadAuthTag   Bytes
  payloadAad       Bytes
  cipher           ArchiveCipher      @default(AES_256_GCM)
  compression      ArchiveCompression @default(GZIP)

  keyId            String
  rawSize          Int
  compressedSize   Int

  archivedAt       DateTime           @default(now()) @db.Timestamptz(6)
  retentionRunId   String?
  retentionRun     RetentionRun?      @relation(fields: [retentionRunId], references: [id])

  @@index([clinicId, archivedAt])
  @@index([clinicId, ticketCode])
  @@index([clinicId, status, completedAt])
  @@index([retentionRunId])
  @@map("cold_ticket_archive")
}

// -----------------------------------------------------------------------------
// RetentionRun — observability for the daily archive sweep
// -----------------------------------------------------------------------------

model RetentionRun {
  id              String    @id @default(cuid())

  clinicId        String?
  clinic          Clinic?   @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  startedAt       DateTime  @default(now()) @db.Timestamptz(6)
  finishedAt      DateTime? @db.Timestamptz(6)

  cutoff          DateTime  @db.Timestamptz(6)
  scanned         Int       @default(0)
  archived        Int       @default(0)
  purged          Int       @default(0)
  failed          Int       @default(0)
  bytesRaw        BigInt    @default(0)
  bytesCompressed BigInt    @default(0)

  workerId        String?
  lastError       String?   @db.Text

  archives        ColdTicketArchive[]

  @@index([clinicId, startedAt])
  @@index([startedAt])
  @@map("retention_runs")
}

// -----------------------------------------------------------------------------
// AuditLog — HMAC-chained immutable ledger
// -----------------------------------------------------------------------------
//
// Every record is signed with HMAC-SHA256(secret, prevSignature || payload),
// forming a hash chain — see src/lib/audit.ts. Tampering with any historical
// row breaks every signature from that point forward, which the verifier
// can detect in O(n).
// -----------------------------------------------------------------------------

model AuditLog {
  id            String      @id @default(cuid())

  clinicId      String
  clinic        Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  actorId       String?
  action        AuditAction
  targetType    String
  targetId      String

  payload       Json        @default("{}") @db.JsonB

  ip            String?     @db.Inet
  userAgent     String?

  // -- Cryptographic chain ------------------------------------------------
  /// Pointer to the previous AuditLog within the same clinicId. NULL for
  /// the first row of each tenant.
  previousId    String?
  /// HMAC-SHA256 over `${previousSignature ?? ""}|${canonicalJson(payload)}`,
  /// hex-encoded. 64 chars long.
  signature     String

  createdAt     DateTime    @default(now()) @db.Timestamptz(6)

  @@index([clinicId, createdAt])
  @@index([clinicId, targetType, targetId])
  @@index([action, createdAt])
  @@index([clinicId, previousId])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// SlaIncident — one row per SLA breach (consultation overrun)
// -----------------------------------------------------------------------------

model SlaIncident {
  id              String     @id @default(cuid())

  clinicId        String
  clinic          Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  hotTicketId     String
  hotTicket       HotTicket  @relation(fields: [hotTicketId], references: [id], onDelete: Cascade)

  /// Triage budget in seconds at the time of the breach.
  budgetSec       Int
  /// Actual duration in seconds when the breach was detected.
  observedSec     Int
  /// observedSec - budgetSec, kept denormalized for cheap analytics.
  overrunSec      Int

  /// Who was working on the ticket when the breach was detected.
  doctorId        String?
  doctorName      String?

  /// Set when the incident is reviewed by an admin.
  resolvedAt      DateTime?  @db.Timestamptz(6)
  resolutionNote  String?    @db.Text

  detectedAt      DateTime   @default(now()) @db.Timestamptz(6)

  @@index([clinicId, detectedAt])
  @@index([clinicId, doctorId, detectedAt])
  @@index([resolvedAt])
  @@map("sla_incidents")
}
