# --- PostgreSQL (hot + archive on same cluster, separate logical DBs allowed) ---
DATABASE_URL="postgresql://navbat:navbat@localhost:5432/navbatcore?schema=public&connection_limit=20&pool_timeout=10"
DIRECT_DATABASE_URL="postgresql://navbat:navbat@localhost:5432/navbatcore?schema=public"

# --- Redis (Pub/Sub + ephemeral queue cache) ---
REDIS_URL="redis://localhost:6379/0"
REDIS_NAMESPACE="navbat"

# --- Realtime ---
SOCKET_PORT="4001"
SOCKET_ORIGIN="http://localhost:3000"

# --- Cold Archive Encryption ---
# 32 bytes, base64 encoded. Generate: `openssl rand -base64 32`
ARCHIVE_ENCRYPTION_KEY="REPLACE_ME_BASE64_32_BYTES"
ARCHIVE_KEY_ID="ark-2026-05"

# --- Retention Worker ---
RETENTION_DAYS="7"
RETENTION_CRON="*/10 * * * *"
RETENTION_BATCH_SIZE="500"
RETENTION_RUN_ONCE="0"

# --- App ---
NODE_ENV="development"
LOG_LEVEL="info"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4001"
